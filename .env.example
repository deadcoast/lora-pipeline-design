# Copy this file to ".env" and edit the paths for your machine.
# Windows paths: use forward slashes OR double-backslashes to avoid escaping bugs.

# --- ComfyUI ---
# Host:port where the ComfyUI server is listening.
# In Comfy Desktop the server runs locally; the default API port is 8188.
COMFY_HOST=127.0.0.1:8188

# Where ComfyUI loads LoRAs from. MIVIM LoRA Studio discovers this automatically.
# Current Comfy Desktop 2 commonly uses a shared library such as:
#   C:/Users/<you>/AppData/Local/Comfy-Desktop/ComfyUI-Shared/models/loras
# The exact root is user-configurable, so do not assume that example is correct.
# Advanced CLI users should set the actual folder shown in Comfy Desktop.
COMFY_LORA_DIR=C:/path/to/ComfyUI-Shared/models/loras

# The SDXL checkpoint filename as ComfyUI sees it (must exist in models/checkpoints).
COMFY_SDXL_CKPT=sd_xl_base_1.0.safetensors
# Match the checkpoint variant: sdxl, noobai-xl-epsilon, or noobai-xl-vpred.
MIVIM_MODEL_PROFILE=sdxl

# --- ai-toolkit (the trainer) ---
# Absolute path to your cloned https://github.com/ostris/ai-toolkit
AI_TOOLKIT_DIR=C:/dev/ai-toolkit
# The python.exe inside ai-toolkit's OWN venv (keep it isolated from ComfyUI).
AI_TOOLKIT_PYTHON=C:/dev/ai-toolkit/venv/Scripts/python.exe

# --- Project paths (usually leave as-is; relative to repo root) ---
DATASETS_DIR=datasets
CHECKPOINTS_DIR=outputs/checkpoints
GRIDS_DIR=outputs/grids
RUN_CONFIGS_DIR=outputs/configs
